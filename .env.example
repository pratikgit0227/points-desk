# Copy to .env.local for local development: cp .env.example .env.local
# On Vercel these are set in Project Settings → Environment Variables (or `vercel env pull`).

# Nothing here is required. The app reads balances in the browser for free.

# Optional AI fallback for /api/extract (AI Gateway usage is billed). Set to 1 to turn it on.
ENABLE_AI_EXTRACT=
# Vercel AI Gateway key for local use. Not needed on Vercel deployments (OIDC).
AI_GATEWAY_API_KEY=

# Optional: model used for reading balances (any AI Gateway model ID).
EXTRACT_MODEL=anthropic/claude-haiku-5.5

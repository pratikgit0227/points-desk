    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.164",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}

{
  "name": "points-desk",
  "version": "1.0.0",
  "private": true,
  "description": "Credit card reward points calculator for Indian cards: transfer partners ranked by rupee value, booking finder, card picker and award guides.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
